    <title>TargetHit Trading Terminal | Free Charts &amp; Demo Trading</title>
    <script>
      (() => {
        let theme;
        try {
          const saved = localStorage.getItem('theme.v2');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch (_) {}
        // [THEME-DEFAULT-DARK 2026-08-21 - Rick] default dark, no OS consult;
        // explicit choices persist under theme.v2.
        if (!theme) theme = 'dark';
        const root = document.documentElement;
        root.dataset.theme = theme;
        root.classList.remove('light', 'dark');
        root.classList.add(theme);
        root.style.colorScheme = theme;
        root.style.setProperty('--th-boot-bg', theme === 'light' ? '#e5eaf0' : '#0d0d0d');
        document.querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'light' ? '#e5eaf0' : '#0d0d0d');
      })();
      (() => {
        // [HQ504 → HQ925 I18N] Locale before React, as resolveBootLocale() in
        // src/i18n/locales.js decides it: 1. ?lang= previews ONE load (it writes
        // no cookie); 2. a chart pane speaks its page's language; 3. the site page
        // the member came from (its /es, /pt-br or /tr prefix, else English: the
        // site's language is its URL); 4. targethit.com's th_locale cookie, for a
        // PUBLIC locale only (a hidden locale's cookie is a preview leftover, never
        // a choice); 5. English. The language subtag decides a tag.
        const PUBLIC_LOCALES = ['en'];
        const SITE_PREFIXES = { es: 'es-419', 'pt-br': 'pt-BR', tr: 'tr' };
        const localeOf = (raw) => ({ en: 'en', es: 'es-419', pt: 'pt-BR', tr: 'tr' })[String(raw || '').trim().toLowerCase().replace(/_/g, '-').split('-')[0]] || null;
        let locale = null;
        try { locale = localeOf(new URLSearchParams(location.search).get('lang')); } catch (_) {}
        if (!locale) try { if (window.parent !== window) locale = localeOf(window.parent.document.documentElement.lang); } catch (_) {}
        if (!locale) try {
          const from = new URL(document.referrer);
          if (from.origin === location.origin && !/^\/trade(\/|$)/i.test(from.pathname)) {
            locale = SITE_PREFIXES[(from.pathname.split('/')[1] || '').toLowerCase()] || 'en';
          }
        } catch (_) {}
        if (!locale) {
          const match = document.cookie.match(/(?:^|;\s*)th_locale=([^;]*)/);
          let chosen = null;
          if (match) try { chosen = localeOf(decodeURIComponent(match[1])); } catch (_) {}
          if (chosen && PUBLIC_LOCALES.indexOf(chosen) >= 0) locale = chosen;
        }
        document.documentElement.lang = locale || 'en';
      })();
    </script>
